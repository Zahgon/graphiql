# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.yml text eol=lf
.yarn/releases/*.cjs export-ignore binary linguist-generated
